    "@mapbox/vector-tile": "^3.0.0",
    "@protomaps/basemaps": "^5.7.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "hls.js": "^1.7.4",
    "maplibre-gl": "^6.16.0",
    "minisearch": "^7.2.0",
    "next": "^16.4.5",
    "openseadragon": "^6.1.1",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.1",
    "zod": "^4.6.7"
