    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate:data": "tsx scripts/validate-data.ts",
    "cek:bahasa": "node scripts/cek-bahasa.mjs",
    "cek:skor": "node scripts/skor-tampilan.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
