# Aset peta. Kosong = pakai berkas lokal public/tiles/batam.pmtiles (development).
NEXT_PUBLIC_PMTILES_URL=

# Supabase (Tukang Langganan, koreksi data, kiriman foto). Kosong = fitur kiriman tampil "belum aktif".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tombol Terbitkan Perubahan di /admin/makanan. Kosong = tombol memberi tahu belum tersambung.
RAILWAY_API_TOKEN=

# Alamat situs untuk metadata dan OG image.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tombol donasi. Kosong = tombol tidak tampil.
NEXT_PUBLIC_DONASI_URL=

# Mode contoh Tukang Langganan: data fiktif di memori server. Hanya berlaku bila variabel Supabase kosong.
# Kosong di produksi = formulir jujur menyatakan belum menerima kiriman. Isi 1 hanya untuk dev dan e2e.
NEXT_PUBLIC_MODE_CONTOH=
# Kata sandi admin di mode contoh. Kosong = admin tertutup.
ADMIN_MODE_CONTOH=

# Peta isometrik sampul beranda dan Jelajahi. Semua kosong = peta Barelang di Cloudflare Pages (lib/peta-sampul.ts).
# Isi untuk menguji versi baru dari server lokal barelang-iso, mis. http://127.0.0.1:8765/<versi>/barelang.dzi.
NEXT_PUBLIC_SAMPUL_DZI=
# Nama peta di Jelajahi, mis. Barelang.
NEXT_PUBLIC_SAMPUL_JUDUL=
# Bingkai sampul dalam piksel gambar x0,y0,x1,y1.
NEXT_PUBLIC_SAMPUL_BINGKAI=
# Warna laut di luar tepi gambar, mis. #668793.
NEXT_PUBLIC_SAMPUL_LATAR=
# Lapisan tempat dan data kota di Jelajahi (URL JSON).
NEXT_PUBLIC_SAMPUL_POI=
NEXT_PUBLIC_SAMPUL_KOTA=
